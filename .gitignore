# Secrets: never commit
.env

# Dependencies and Netlify local state
node_modules/
.netlify/

# Built pages (Netlify runs `npm run build`); assets in site/assets are source and stay tracked
site/*.html
site/guides.json
site/_headers
site/_redirects
# Derived cover JPEGs (built from the PNGs at build time)
site/assets/covers/*.jpg

# Large reference files that do not belong in the repo
dr-berg-guides-reference.png
mockup/lifeuntox-guides-site.zip

# OS noise
.DS_Store
Thumbs.db
