# Copy to .env and fill in. Never commit .env.

# Beehiiv (https://app.beehiiv.com → Settings → API)
BEEHIIV_API_KEY=
BEEHIIV_PUB_ID=pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional. By default the email gate posts to the site's own
# /.netlify/functions/subscribe, which subscribes via the API above.
# Set this to an https URL only if you want the gate to post the email
# elsewhere instead (a plain <form action> endpoint). Embed snippets are ignored.
BEEHIIV_FORM_ACTION=
# Optional. Custom field names phone-save.js writes to (defaults: phone, sms_consent)
# BEEHIIV_PHONE_FIELD=phone
# BEEHIIV_SMS_CONSENT_FIELD=sms_consent

# Kie.ai (Nano Banana Pro) for cover generation
KIE_API_KEY=

# Optional: absolute site URL used for canonical, Open Graph and JSON-LD.
# Netlify sets URL automatically; this overrides it.
# SITE_URL=https://guides.lifeuntox.com
